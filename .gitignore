# ─── Dependencies ────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build output ────────────────────────────────────────────────
dist/
build/
out/
.next/
.turbo/
.vite/
.cache/
*.tsbuildinfo

# Per-workspace build dirs (npm workspaces)
apps/*/dist/
apps/*/build/
packages/*/dist/

# ─── Environment & secrets (NEVER COMMIT) ────────────────────────
# Real env files
.env
.env.*
# Allow only the example template
!.env.example
!**/.env.example

# Other credential / secret stores
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account*.json

# ─── Database ────────────────────────────────────────────────────
# Prisma generated client (regenerated by `prisma generate`)
.prisma/
**/.prisma/
# Local SQLite if we ever fall back to it
*.sqlite
*.sqlite-journal
*.db
# Postgres dumps & backups
*.sql.gz
*.dump
backup/

# ─── Logs ────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# ─── Test / coverage ─────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── Editors / IDEs ──────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ─── OS clutter ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Local-only / personal scratch ───────────────────────────────
# Anything ending in .local.* is yours alone, not for the repo
*.local
*.local.*
.history/
.scratch/
TODO.local.md
NOTES.local.md
scratch/
private/

# ─── Tooling ─────────────────────────────────────────────────────
.eslintcache
.stylelintcache
*.tgz
.npm/
.yarn/
.pnp.*
